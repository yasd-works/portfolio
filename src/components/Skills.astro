---
import { skillGroups } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---
<section id="skills" aria-labelledby="skills-heading" class="border-y border-line bg-panel/40 py-20 sm:py-24">
  <div class="shell">
    <SectionHeading number="02" label="Expertise & toolkit" title="分析から実装、運用まで。" description="目的に合わせて技術を選び、現場で機能する仕組みへ。専門領域をつないで、プロジェクトを進めます。" id="skills-heading" />
    <div class="grid gap-x-14 md:grid-cols-2">
      {skillGroups.map((group) => (
        <article class="border-t border-line py-8">
          <div class="flex items-baseline gap-4"><span class="font-mono text-xs text-gold">{group.number}</span><h3 class="text-lg font-medium tracking-wide">{group.title}</h3></div>
          <p class="mt-3 text-xs leading-7 text-muted">{group.description}</p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={group.title}>{group.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>
