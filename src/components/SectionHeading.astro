---
interface Props { label: string; title: string; description?: string; id: string; }
const { label, title, description, id } = Astro.props;
const titlePhrases = title.split(/(?<=、)/u);
---
<div class="section-heading">
  <div><p class="section-label">{label}</p><h2 id={id}>{titlePhrases.map((phrase) => <span class="heading-phrase">{phrase}</span>)}</h2></div>
  {description && <p class="section-description">{description}</p>}
</div>
