---
interface Props { number: string; label: string; title: string; description: string; id: string; }
const { number, label, title, description, id } = Astro.props;
---
<div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end">
  <div>
    <p class="eyebrow mb-4"><span class="mr-4 text-muted">{number} /</span>{label}</p>
    <h2 id={id} class="text-2xl leading-relaxed font-semibold tracking-tight sm:text-3xl">{title}</h2>
  </div>
  <p class="max-w-md text-sm leading-7 text-muted">{description}</p>
</div>
